apiVersion: v1
kind: Service

metadata:
  name: backend-service
  namespace: cloudops

spec:
  type: ClusterIP

  selector:
    app: backend

  ports:
    - port: 8081
      targetPort: 8081
apiVersion: v1
kind: ConfigMap

metadata:
  name: cloudops-config
  namespace: cloudops

data:

  # PostgreSQL
  POSTGRES_DB: cloudops_db
  POSTGRES_USER: cloudops

  # Spring Boot
  SPRING_DATASOURCE_URL: jdbc:postgresql://postgres-service:5432/cloudops_db
  SPRING_DATASOURCE_USERNAME: cloudops

  # Frontend
  VITE_API_URL: /api

  #backen_port
  APP_PORT: "8081"
apiVersion: apps/v1
kind: Deployment

metadata:
  name: frontend
  namespace: cloudops

spec:
  replicas: 2

  selector:
    matchLabels:
      app: frontend

  template:
    metadata:
      labels:
        app: frontend

    spec:
      containers:
        - name: frontend
          image: abdullahahmed1101076/cloudops-frontend:v1
          imagePullPolicy: IfNotPresent

          ports:
            - containerPort: 80
apiVersion: v1
kind: Namespace

metadata:
  name: cloudops
apiVersion: v1
kind: PersistentVolumeClaim

metadata:
  name: postgres-pvc
  namespace: cloudops

spec:
  accessModes:
    - ReadWriteOnce

  resources:
    requests:
      storage: 1Gi
apiVersion: v1
kind: Secret

metadata:
  name: cloudops-secret
  namespace: cloudops

type: Opaque

data:
  POSTGRES_PASSWORD: Y2xvdWRvcHMxMjM=
  SPRING_DATASOURCE_PASSWORD: Y2xvdWRvcHMxMjM=
apiVersion: apps/v1
kind: Deployment

metadata:
  name: backend
  namespace: cloudops

spec:
  replicas: 2

  selector:
    matchLabels:
      app: backend

  template:
    metadata:
      labels:
        app: backend

    spec:
      containers:
        - name: backend
          image: abdullahahmed1101076/cloudops-backend:v1
          imagePullPolicy: IfNotPresent

          ports:
            - containerPort: 8081

          envFrom:
            - configMapRef:
                name: cloudops-config

            - secretRef:
                name: cloudops-secret
apiVersion: v1
kind: Service

metadata:
  name: frontend-service
  namespace: cloudops

spec:
  type: ClusterIP

  selector:
    app: frontend

  ports:
    - port: 80
      targetPort: 80
apiVersion: networking.k8s.io/v1
kind: Ingress

metadata:
  name: cloudops-ingress
  namespace: cloudops

spec:
  ingressClassName: nginx

  rules:
    - host: cloudops.local

      http:
        paths:

          - path: /
            pathType: Prefix

            backend:
              service:
                name: frontend-service
                port:
                  number: 80

          - path: /api
            pathType: Prefix

            backend:
              service:
                name: backend-service
                port:
                  number: 8081
apiVersion: apps/v1
kind: Deployment

metadata:
  name: postgres
  namespace: cloudops

spec:
  replicas: 1

  selector:
    matchLabels:
      app: postgres

  template:
    metadata:
      labels:
        app: postgres

    spec:
      containers:
        - name: postgres
          image: postgres:16

          ports:
            - containerPort: 5432

          envFrom:
            - configMapRef:
                name: cloudops-config
            - secretRef:
                name: cloudops-secret

          volumeMounts:
            - name: postgres-storage
              mountPath: /var/lib/postgresql/data

      volumes:
        - name: postgres-storage
          persistentVolumeClaim:
            claimName: postgres-pvc
